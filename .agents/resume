#!/usr/bin/env bash
set -euo pipefail

if [[ ! -f "$HOME/.vite-plus/env" ]]; then
  echo "Vite+ is unavailable; rerun .agents/setup." >&2
  exit 1
fi

# shellcheck disable=SC1091
source "$HOME/.vite-plus/env"

command -v vp >/dev/null
command -v node >/dev/null
test -d node_modules

echo "Orb runtime and workspace dependencies are ready."
